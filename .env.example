# GEMINI_API_KEY: Get your API key from https://aistudio.google.com/app/apikey
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="your_gemini_api_key_here"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# NEBIUS_API_KEY: Token Factory API key for NVIDIA Nemotron model inference
NEBIUS_API_KEY=""

# NEBIUS_BASE_URL: Nebius Token Factory OpenAI-compatible API base URL
NEBIUS_BASE_URL="https://api.tokenfactory.nebius.com/v1/"

# NEBIUS_MODEL: Configurable NVIDIA model identifier
NEBIUS_MODEL="nvidia/Nemotron-3_5-Lightning"
